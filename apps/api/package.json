    "@chat/db": "workspace:*",
    "@chat/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.3.9",
    "bullmq": "^6.2.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.1",
    "ulid": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
